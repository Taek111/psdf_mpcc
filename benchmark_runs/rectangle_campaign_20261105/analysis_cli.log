+                pose_match=np.allclose(ra[['initial_x','initial_y','initial_theta']].to_numpy(dtype=float), rb[['initial_x','initial_y','initial_theta']].to_numpy(dtype=float),rtol=0,atol=1e-12)
+                sa,sb=ra.status=='success',rb.status=='success'
