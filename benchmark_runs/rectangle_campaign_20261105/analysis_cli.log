+                                   seeds=json.dumps([int(x) for x in common4])))
+        for a,b in itertools.combinations(METHODS,2):
+            shared = sorted(set(by[a][by[a].status.isin(COMPLETE)].index)&set(by[b][by[b].status.isin(COMPLETE)].index))
+            buckets = Counter()
+            diffs=[]
