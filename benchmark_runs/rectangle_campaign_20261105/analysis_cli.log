+    save(tr, 'trials_enriched.csv')
+    save(su, 'success_and_runtime_summary.csv')
+    save(ti, 'pooled_solve_nlp_times.csv')
+    save(pd.DataFrame(raw_audit), 'raw_timing_exclusions.csv')
+    save(tr[tr.status != 'success'], 'failure_trials.csv')
