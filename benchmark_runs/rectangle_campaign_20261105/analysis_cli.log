+def wilson(k, n):
+    if not n:
+        return np.nan, np.nan
+    z = 1.959963984540054
+    p = k/n
+    d = 1+z*z/n
+    center = (p+z*z/(2*n))/d
+    radius = z/d*math.sqrt(p*(1-p)/n+z*z/(4*n*n))
+    return max(0., center-radius), min(1., center+radius)
+
